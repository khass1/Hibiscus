# Cloudflare Pages — response headers
# Docs: https://developers.cloudflare.com/pages/configuration/headers/
# Rules are matched top-down; more specific paths override /*.

# ----------------------------------------------------------------
# Security headers — applied site-wide
# ----------------------------------------------------------------
/*
  # HSTS — 15552000 = 180 days. Raised from the initial 1-day value on
  # 2026-08-06, after the site ran stable on HTTPS since 2026-07-22.
  # Still NO includeSubDomains: it would cover every subdomain, and that has
  # not been audited. Still NO preload: it is effectively irreversible.
  Strict-Transport-Security: max-age=15552000
  # Block MIME-type sniffing
  X-Content-Type-Options: nosniff
  # Disallow framing by other origins (clickjacking)
  X-Frame-Options: SAMEORIGIN
  # Send origin only on cross-origin requests, full path same-origin
  Referrer-Policy: strict-origin-when-cross-origin
  # Explicitly disable browser features the site does not use
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  # Todo JS executável é asset same-origin fingerprintado — 'self' cobre.
  #
  # SEM hashes de JSON-LD, de propósito. <script type="application/ld+json">
  # é data block: o "prepare the script element" do HTML retorna antes da
  # verificação de CSP, então script-src nunca se aplica a ele. Verificado
  # neste site com a própria CSP ativa — um bloco ld+json fora da allowlist
  # carrega sem violação, enquanto um <script> inline comum é bloqueado.
  # Hashes aqui não protegeriam nada e quebrariam a cada página nova: o @id
  # de cada bloco usa .Permalink, então o conteúdo é único por URL.
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src https://maps.google.com https://www.google.com; frame-ancestors 'self'; form-action 'self'; upgrade-insecure-requests

# ----------------------------------------------------------------
# Caching — fingerprinted assets can be cached hard
# ----------------------------------------------------------------

# Hugo fingerprints o CSS (main.min.<hash>.css e noscript.min.<hash>.css), então
# a URL muda sempre que o conteúdo muda. Pode cachear como imutável.
/css/*
  Cache-Control: public, max-age=31536000, immutable

# Mesma regra do CSS: /js/main.min.<hash>.js é fingerprintado pelo Hugo.
/js/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts are NOT fingerprinted (fixed filenames). One year is still the
# right call — they effectively never change. If you ever replace a font
# file, RENAME it (e.g. -v2.woff2) so clients pick up the new version.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Images change occasionally (og.jpg, factory photos) — long but not immutable.
/img/*
  Cache-Control: public, max-age=2592000

# Icons — stable, but keep replaceable.
/favicon.svg
  Cache-Control: public, max-age=2592000
/favicon-32.png
  Cache-Control: public, max-age=2592000
/favicon-192.png
  Cache-Control: public, max-age=2592000
/apple-touch-icon.png
  Cache-Control: public, max-age=2592000
